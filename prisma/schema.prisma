generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum LinkKind {
  GITHUB
  LINKEDIN
  TELEGRAM
  WEBSITE
  OTHER

  @@map("link_kind")
}

enum SkillCategory {
  LANGUAGE
  FRAMEWORK
  DATABASE
  PLATFORM
  PRACTICE

  @@map("skill_category")
}

model Profile {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique @db.VarChar(64)
  name        String   @db.VarChar(120)
  description String   @db.VarChar(2000)
  contentHash String   @map("content_hash") @db.VarChar(64)
  version     Int      @default(1)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  links       ProfileLink[]
  skills      Skill[]
  experiences Experience[]
  projects    Project[]

  @@map("profiles")
}

model ProfileLink {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String   @map("profile_id") @db.Uuid
  kind      LinkKind
  label     String   @db.VarChar(80)
  url       String   @db.VarChar(500)
  sortOrder Int      @map("sort_order")
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, kind, url])
  @@unique([profileId, sortOrder])
  @@index([profileId])
  @@map("profile_links")
}

model Skill {
  id        String        @id @default(uuid()) @db.Uuid
  profileId String        @map("profile_id") @db.Uuid
  name      String        @db.VarChar(80)
  category  SkillCategory
  sortOrder Int           @map("sort_order")
  profile   Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  projects  ProjectSkill[]

  @@unique([profileId, name])
  @@unique([profileId, sortOrder])
  @@index([profileId])
  @@map("skills")
}

model Experience {
  id           String        @id @default(uuid()) @db.Uuid
  profileId    String        @map("profile_id") @db.Uuid
  company      String        @db.VarChar(160)
  position     String        @db.VarChar(160)
  startDate    String        @map("start_date") @db.VarChar(10)
  endDate      String?       @map("end_date") @db.VarChar(10)
  sortOrder    Int           @map("sort_order")
  profile      Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  achievements Achievement[]

  @@unique([profileId, company, position, startDate])
  @@unique([profileId, sortOrder])
  @@index([profileId, startDate])
  @@map("experiences")
}

model Achievement {
  id           String     @id @default(uuid()) @db.Uuid
  experienceId String     @map("experience_id") @db.Uuid
  text         String     @db.VarChar(500)
  sortOrder    Int        @map("sort_order")
  experience   Experience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([experienceId, sortOrder])
  @@index([experienceId])
  @@map("achievements")
}

model Project {
  id        String         @id @default(uuid()) @db.Uuid
  profileId String         @map("profile_id") @db.Uuid
  name      String         @db.VarChar(160)
  url       String         @db.VarChar(500)
  summary   String?        @db.VarChar(500)
  sortOrder Int            @map("sort_order")
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skills    ProjectSkill[]

  @@unique([profileId, name])
  @@unique([profileId, url])
  @@unique([profileId, sortOrder])
  @@index([profileId])
  @@map("projects")
}

model ProjectSkill {
  projectId String  @map("project_id") @db.Uuid
  skillId   String  @map("skill_id") @db.Uuid
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  skill     Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([projectId, skillId])
  @@index([skillId])
  @@map("project_skills")
}
